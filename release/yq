#!/usr/bin/env bash
#
# Shim installed alongside the `devbase` release binary so a working
# `yq` (python-yq/gojq-compatible, not mikefarah go-yq v4) is available
# without a separate install. Delegates to `devbase yq`.

set -euo pipefail

# Mirrors devbase_run (shell/lib/devbase.sh), which a shim can't source.
if [[ -n ${CI:-} ]]; then
  export GOBOX_SKIP_VALIDATE_AUTH=true
fi
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/devbase" --skip-update yq "$@"
